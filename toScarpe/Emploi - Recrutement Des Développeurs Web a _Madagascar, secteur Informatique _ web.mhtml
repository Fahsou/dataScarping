.tous { position: absolute; bottom: 0px; margin-left: 0.25rem; margin-bottom: 0.75rem; }

.tous a { width: 190px; cursor: pointer; color: rgb(25, 153, 217) !important; font-size: 1.1rem !important; padding: 0px !important; background: url("../img/chevron-right.png") right 0px center no-repeat rgb(255, 255, 255) !important; }

