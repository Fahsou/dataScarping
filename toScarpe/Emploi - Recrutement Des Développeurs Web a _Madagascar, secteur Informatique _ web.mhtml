.menu_titre { font-style: normal; font-weight: 700; line-height: 150%; color: rgb(25, 153, 217) !important; font-size: 14px !important; text-decoration: none !important; text-transform: uppercase !important; }

.underline { display: inline-block; border-bottom: 2px solid rgb(25, 153, 217); padding-bottom: 3px; }

.menu_ul li ul li ul li a { cursor: pointer; text-decoration: none !important; margin: 0px !important; padding: 0.5rem !important; height: 2.5rem !important; }

.menu_ul li ul li ul li a:hover { color: rgb(25, 153, 217); }

.menu_ul li ul li div div a { color: rgb(0, 0, 0); display: block; box-sizing: border-box; text-transform: none; cursor: pointer; font-size: 1rem !important; margin: 0px !important; padding: 0.5rem !important; height: 2.5rem !important; text-decoration: none !important; }

.menu_ul li ul li div div a:hover { background: rgb(244, 244, 244); border-radius: 8px; }

