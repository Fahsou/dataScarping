.secter_list { margin-left: 25.4%; display: block !important; width: 100% !important; padding: 0px 0px 0px 1.8rem !important; }

.secter_list a { font-size: 1rem !important; }

.secter_parent { padding-left: 2rem; }

.fils { height: 455px !important; box-shadow: rgba(0, 0, 0, 0.3) 0px 7px 7px; }

