html { width: 100%; height: 100%; margin: 0px; padding: 0px; font-size: 100%; }

body { font-family: lato; font-size: 1rem; margin: 0px; padding: 0px; transition: 500ms; }

.contenu { margin: 0px auto; padding: 0px; width: 75rem; display: block; clear: both; }

header { margin: 0px; padding: 0px; top: 0px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.5) 0px 0px 10px; height: 4.3rem; width: 100%; position: fixed; z-index: 10; }

ul { margin: 0px; padding: 0px; }

ul li { list-style: none; }

a, a:hover { text-decoration: none; }

header .contenu { position: relative; height: 5.4375rem; }

.logo { width: 8.125rem; height: auto; position: relative; top: 0.35rem; transition: 500ms; }

.milieu_header { display: table; margin: 0px auto; padding: 0.75rem 0px 0px; width: auto; }

.menu_haut { width: auto; margin: 0px auto; display: -webkit-flex; justify-content: center; }

.menu_haut li { position: relative; padding: 0px 0.625rem; margin: 0px; }

.menu_haut li::before { position: absolute; right: 0px; content: "|"; color: rgb(255, 255, 255); font-size: 0.625rem; bottom: 0.125rem; }

.menu_haut li:last-child::before { content: ""; }

.menu_haut li a { font-size: 0.625rem; color: rgb(255, 255, 255); text-transform: uppercase; }

.head_tittle { margin: 0px; padding: 0.5rem 0px; color: rgb(255, 255, 255); font-family: latolight; font-weight: normal; text-transform: uppercase; font-size: 1.125rem; }

.menu_haut li a:hover { text-decoration: underline; }

.head_tittle b { font-weight: normal; font-family: latobold; }

.cta_inscription { margin-left: 7rem; line-height: 1rem; font-size: 1.2rem; }

.cta_inscription b { color: rgb(119, 186, 13); display: block; }

.cta_inscription a { color: rgb(119, 186, 13); }

.cta_inscription img { position: absolute; top: 0px; margin-left: 8.5rem; height: 3.3rem; margin-top: 0.5rem; }

.menu { width: 100%; margin: 0px; padding: 0px; position: relative; }

.menu_ul { width: 75rem; margin: 0px auto; padding: 0px; transition: 500ms; }

.menu_ul li { display: inline-block; }

.menu_ul li.parent:not(:first-child) > a { color: rgb(26, 154, 217); font-weight: bold; position: relative; top: -1rem; }

.menu_ul li.parent a { color: rgb(0, 0, 0); font-size: 1.1rem; display: block; margin: 0px 0px 0px 0.25rem; padding: 0px 0.5rem; height: 1.65rem; box-sizing: border-box; }

ul > .connect.menu_special { margin-left: 4rem; }

.menu_ul li.candidat { background: none; }

.menu_ul li.candidat::after { background: rgb(137, 206, 27); display: block; position: absolute; content: ""; width: 100%; height: 100%; left: 0px; top: 0px; transform: skew(-23deg); z-index: -1; }

.menu_ul li.recruteur { background: none; }

.menu_ul li.recruteur::after { background: rgb(250, 60, 1); display: block; position: absolute; content: ""; width: 100%; height: 100%; left: 0px; top: 0px; transform: skew(-23deg); z-index: -1; }

.menu_ul li.connect { background: none; }

.menu_ul li.connect::after { background: rgb(25, 153, 217); display: block; position: absolute; content: ""; width: 100%; height: 100%; left: 0px; top: 0px; transform: skew(-23deg); z-index: -1; }

.menu_ul li a.candidat::after { background-color: rgb(137, 206, 27); }

.menu_ul li a.candidat::before { background: url("../img/candidat.png") 0px 0px no-repeat; }

.menu_ul li a.recruteur::after { background-color: rgb(250, 60, 1); }

.menu_ul li a.recruteur::before { background: url("../img/recruteur.png") 0px 0px no-repeat; }

.menu_ul li.connect a::after { background-color: rgb(25, 153, 217); }

.menu_ul li.connect a::before { background: url("../img/connexion.png") 0px 0px no-repeat; }

.menu_ul li.menu_special > a { display: inline-block; padding: 2.5rem 1.5rem 0.45rem 0.5rem; position: relative; top: -0.5rem; font-weight: bold; color: rgb(255, 255, 255); transform: skew(0deg); z-index: 21; margin: 0px !important; }

.menu_ul li.menu_special { transform: skew(0deg); position: relative; }

.menu_ul li.menu_special > a::before { position: absolute; content: ""; width: 1.25rem; height: 1.25rem; top: 1.125rem; left: 40%; }

.menu_ul li.menu_special > a::after { position: absolute; content: ""; top: 4.5rem; left: 40%; border: 1px solid rgb(255, 255, 255); border-radius: 18px; box-shadow: rgb(136, 136, 136) 0px 0px 2px; height: 7px; width: 7px; }

a.home { width: 1.65rem; height: 1.65rem; background: url("../img/icone.png") 5px -23px / 500px no-repeat; }

.menu_ul li ul { padding: 1.75rem 0.5rem 0.5rem; box-sizing: border-box; background: rgb(255, 255, 255); position: absolute; left: 0px; top: 1.75rem; z-index: 0; }

.mt_top .menu_ul li ul { top: 4.3rem; }

.menu_ul li ul { top: 4.3rem; }

.menu_ul li.parent ul { display: none; transition: 500ms; }

.menu_ul li.parent.showsoon ul { display: block; bottom: auto; }

.menu_ul li ul li { width: 25%; float: left; }

.menu_ul li ul li a { text-transform: none; margin-bottom: 16px !important; }

.menu_ul li ul li a:hover { text-decoration: underline; }

.search_home { width: 100%; height: 33.75rem; margin: 0px; padding: 0px 0px 2rem; position: relative; }

.search_home .contenu, .recherche_page_interieur .contenu { box-sizing: border-box; position: relative; align-items: center; }

.recherche_page_interieur .inline-form, .search_home .inline-form { margin-left: 0px !important; }

