------MultipartBoundary--TUBhsa7PUp7lljrzryEgwCy8ukhgx8hE8hHVQT1Gmg----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://www.portaljob-madagascar.com/application/resources/css/fiche.css

@charset "utf-8";

@import url("../fonts/font.css");

.fiche_dedie_container { box-shadow: rgba(0, 0, 255, 0.2) 1px 1px 0px 0px; margin-bottom: 1rem; border: 1px solid rgb(233, 233, 233); }

.pagededie_ban { width: 100%; background-size: cover; background-repeat: no-repeat; }

.fiche_dedie { display: flex; justify-content: center; }

.fiche_dedie .slogo { width: 14rem; }

.fiche_dedie .info { width: 28rem; position: relative; padding-left: 1rem; }

.fiche_dedie .info::after { position: absolute; content: ""; background: rgb(197, 204, 206); top: 5%; left: 0px; width: 1px; height: 60%; }

.fiche_dedie .info h3 { text-transform: uppercase; color: rgb(0, 0, 0); font-size: 1rem; }

.fiche_dedie .info h4 { color: rgb(107, 106, 106); font-weight: normal; }

.fiche_dedie .nb_annonce { width: calc(100% - 43rem); text-align: center; margin: 2rem 0px; padding-left: 2rem; }

.fiche_dedie .nb_annonce span { width: 6rem; height: 4.5rem; background: rgb(252, 57, 3); display: block; border-radius: 50%; color: rgb(255, 255, 255); padding-top: 1.5rem; }

.dedie_offre { border: 1px solid rgb(233, 233, 233); padding: 0.75rem; box-shadow: rgba(0, 0, 255, 0.2) 1px 1px 0px 0px; }

.p_suivi { display: flex; margin: 0.75rem 0px; border: 1px solid rgb(204, 204, 204); padding: 1rem 0px; }

.p_suivi .lft { width: 6rem; text-align: center; position: relative; border-right: 1px solid rgb(204, 204, 204); }

.p_suivi .lft .daty { display: block; background: rgb(119, 186, 13); width: 3.75rem; height: 3.25rem; padding-top: 0.5rem; text-align: center; color: rgb(255, 255, 255); margin: 0px auto; border-radius: 50%; font-size: 0.75rem; }

.p_suivi .lft .daty span { display: block; line-height: 0.85rem; font-weight: bold; }

.p_suivi .rgt { float: none; width: calc(100% - 7rem); padding-left: 0.75rem; }

.p_suivi .rgt a { color: rgb(0, 0, 0); text-transform: uppercase; font-family: latobold; }

.p_suivi .rgt a:hover { color: rgb(33, 66, 103); }

.p_suivi .rgt h4 { text-transform: none; color: rgb(120, 117, 116); font-family: lato; font-weight: normal; border: none; }

.p_suivi .rgt h4 span { color: rgb(119, 186, 13); font-weight: bold; }

.p_suivi .rgt h4 i { color: rgb(119, 186, 13); font-size: 0.75rem; padding: 0px 0.35rem 0px 0px; }

.p_suivi .rgt .secteur { color: rgb(120, 117, 116); font-family: latolight; }

.p_suivi .rgt p { color: rgb(0, 0, 0); font-family: latolight; font-size: 0.85rem; }

.dedie_offre .date_lim { color: rgb(25, 153, 218); font-size: 0.85rem; font-weight: 200; }

.dedie_offre ul.paging { text-align: center; }

.dedie_offre ul.paging li { display: inline-block; border: 1px solid rgb(204, 204, 204); width: 2.5rem; height: 1.5rem; margin: 0.5rem 0px; }

.dedie_offre ul.paging li.actif { border-color: rgb(255, 0, 0); }

.dedie_offre ul.paging li a { color: rgb(120, 117, 116); display: block; font-size: 0.85rem; }

.actu_dedie { box-shadow: rgba(0, 0, 255, 0.2) 1px 1px 0px 0px; margin: 1rem 0px; border: 1px solid rgb(233, 233, 233); padding-bottom: 1.5rem; }

.actu_dedie .actu { padding: 0.5rem 2.5rem; position: relative; margin-bottom: 2rem; }

.actu_dedie .actu::after { position: absolute; bottom: 0px; left: 25%; width: 50%; height: 1px; content: ""; background: rgb(105, 105, 105); }

.actu_dedie .actu h4 { color: rgb(0, 0, 0); text-transform: uppercase; font-family: latobold; font-size: 1rem; font-weight: normal; margin: 0px; }

.actu_dedie .actu em { font-size: 0.75rem; color: rgb(120, 117, 116); }

.actu_dedie .actu p { color: rgb(120, 117, 116); font-family: latolight; }

.actu_dedie .actu a.plus { color: rgb(118, 186, 15); display: block; margin: 1rem 0px; }

.actu_dedie .actu a.plus span { display: inline-block; width: 1.5rem; height: 1.5rem; border: 1px solid rgb(118, 186, 15); text-align: center; border-radius: 50%; }

.actu_dedie a.more { color: rgb(255, 255, 255); margin: 1rem 0px; text-align: center; background: rgb(118, 186, 15); padding: 0.5rem 2rem; }

.actu_dedie a.more span { display: inline-block; width: 1.5rem; height: 1.5rem; border: 1px solid rgb(255, 255, 255); text-align: center; border-radius: 50%; }

@media screen and (max-width: 40rem) {
  .fiche_dedie { display: block; width: 100%; }
  .p_suivi { display: block; width: 100%; }
  .fiche_dedie .info, .fiche_dedie .nb_annonce { width: 100%; }
}
