@charset "utf-8";

.clear { clear: both; }

form.login input[type="text"], form.login input[type="password"] { width: 230px; margin: 0px; padding: 0px; border: 1px solid rgb(60, 121, 154); font-size: 10px; height: 19px; }

form.login { padding: 10px; }

.nofloat { float: none !important; }

.bolder { font-weight: bold; }

.nodeco { text-decoration: none; text-transform: none; }

.nodisplay { display: none; }

.w100 { width: 100%; }

.inactif { color: rgb(0, 0, 0); font-style: italic; font-variant: small-caps; }

.border { border: 1px solid rgb(164, 179, 186); }

button { cursor: pointer !important; }

.input-text { margin: 0px; padding: 0px; border: 1px solid rgb(60, 121, 154); font-size: 10px; height: 19px; }

.input-num { text-align: right; }

form.search input[type="password"] { width: 250px; margin: 0px; padding: 0px; border: 1px solid rgb(60, 121, 154); font-size: 10px; height: 19px; }

form.search textarea { width: 250px; margin: 0px; padding: 0px; border: 1px solid rgb(60, 121, 154); font-size: 10px; height: 60px; }

.date_annonce img { text-align: center; vertical-align: middle; margin-top: 0.5rem; }

.contenu_annonce { width: 80%; }

a.back-to-top { background: rgba(10, 213, 206, 0.5); color: rgb(255, 255, 255); padding: 0.25rem 1rem; font-size: 2rem; position: fixed; bottom: 2.5em; right: 2rem; display: none; }

a.back-to-top:hover { background: rgba(137, 206, 27, 0.85); }

.tooltip-help { max-width: 250px !important; }

.col1_max_min .max { width: 100%; }

.search_profil { border: 1px solid rgb(241, 239, 239); box-sizing: border-box; padding: 0.5rem; font-family: latolight; color: rgb(96, 95, 95); margin-bottom: 1rem; }

.search_profil input[type="text"] { width: 100%; }

.search_profil ul li { width: 45%; display: inline-block; cursor: pointer; line-height: 2.2rem; }

.search_profil ul li input[type="checkbox"] { display: none; }

.checked_none { background: url("../img/chk.png") left center / 20px 20px no-repeat; padding: 1rem 0px 1rem 1.6rem; }

.checked_ok { background: url("../img/chk-checked.png") left center / 20px 20px no-repeat; }

.search_profil .niveau_expe { margin-top: 0.5rem; }

#search_interne { position: relative; }

.item_tab h2 { margin: 0px; }

.bout_suivre { float: right; }

.droite .services .inner { background: rgb(137, 119, 181); padding: 1rem; color: rgb(255, 255, 255); font-size: 0.85rem; }

.droite .services h3 { background-color: rgb(250, 140, 1); font-variant: small-caps; color: rgb(255, 255, 255); display: block; margin: 0px; padding: 0.2rem; }

.droite .services .pad { border-left: 5px solid rgb(250, 140, 1); padding-left: 0.6rem; margin-left: 0.5rem; }

.droite .former, .droite .profile { margin-top: 1rem; }

.droite .former h3 { background-color: rgb(20, 148, 213); }

.droite .former .pad { border-color: rgb(20, 148, 213); }

.droite .profile h3 { background-color: rgb(152, 205, 1); }

.droite .profile .pad { border-color: rgb(152, 205, 1); }

.droite .rapide { background: rgb(20, 148, 213); margin-top: 2rem; }

.droite .rapide div { padding: 1rem; }

.droite .rapide h3 { background: none; }

.droite .talend { background-image: url("../img/talent-acquisition-strategy.png"); background-repeat: no-repeat; height: 290px; border: 1px solid rgb(204, 204, 204); background-size: cover; margin-bottom: 2rem; position: relative; }

.droite .talend .info { text-transform: uppercase; color: rgb(255, 255, 255); background: rgba(196, 218, 76, 0.8); width: 6rem; padding: 0.85rem; font-size: 1.2rem; position: absolute; top: 2rem; left: 1rem; }

.droite .pub img { max-width: 21.875rem; }

.boxlogin { width: 250px; }

.boxlogin h1 { background: url("../img/h1right.gif") right top no-repeat rgb(60, 121, 154); color: rgb(255, 255, 255); font-size: 12px; font-weight: bold; padding: 0px 0px 0px 20px; height: 32px; width: 250px; display: table-cell; vertical-align: middle; }

.boxnew { padding: 0px 10px 0px 0px; }

.menu_left ul li a.active { background: rgb(60, 159, 250); color: rgb(255, 255, 255); }

.boxlogout { text-align: right; padding-right: 10px; }

.box-forgot-pass { width: 520px; padding-top: 8px; text-align: right; }

.box-connect-info { padding-top: 20px; text-align: center; }

.outil { background-image: url("../img/outil.png"); }

input.maxi, textarea.maxi { width: 90% !important; }

textarea.haut { height: 90px !important; }

.tiny { font-size: 0.6875rem; }

.txt-center { text-align: center; }

.date_lim { font-size: 0.85rem; font-weight: 200; }

.contenu_annonce h3 a, .contenu_annonce h3 a:visited { color: rgb(0, 0, 0); }

.offre_view { font-family: latolight; }

.mod-remarque-detail { background-color: rgb(232, 232, 232); border-radius: 2px; font-family: latolight; }

.mod-remarque-detail .inner { padding: 0.5rem; }

table tr td { vertical-align: middle; }

table.table_inside { width: 100%; padding: 0px; margin: 0px; }

.table_inside tr td { padding: 10px 0px 10px 3px; }

.table_inside tr td.brdr { border-right: 1px solid rgb(255, 255, 255); }

.table_inside tr.titre td { background: rgb(75, 151, 195); text-align: center; }

.table_inside tr.titre td a { color: rgb(255, 255, 255); text-transform: none; text-decoration: none; padding-right: 10px; }

a.sort-arrow-asc { background: url("../img/sort_asc.png") right center no-repeat; }

a.sort-arrow-desc { background: url("../img/sort_desc.png") right center no-repeat; }

.table_inside tr.modulo1 { background: rgb(238, 238, 238); }

.table_inside tr.modulo2 { background: rgb(240, 249, 254); }

.table_inside tr.titre2 td { background: rgb(207, 207, 207); text-align: center; }

.table_inside tr.titre2 td input[type="text"] { width: 70%; background: rgb(255, 255, 255) !important; }

.range-line { width: 150px; }

.range-line span.label { }

td.bordure { border-top: 1px solid rgb(164, 179, 186); }

.grid { padding-left: 10px; }

.grid select { margin: 0px; padding: 0px; border: 1px solid rgb(124, 146, 183); font-family: Verdana, Geneva, sans-serif; font-size: 10px; }

.ui-dialog .ui-dialog-buttonpane .ui-dialog-buttonset { float: none; }

.ui-dialog .ui-dialog-buttonpane { text-align: center; }

.ui-corner-all, .ui-corner-bottom, .ui-corner-right, .ui-corner-br, .ui-corner-left, .ui-corner-bl, .ui-corner-top, .ui-corner-right, .ui-corner-tr, .ui-corner-left, .ui-corner-tl { border-top-left-radius: 2px; }

.ui-corner-all, .ui-corner-bottom, .ui-corner-right, .ui-corner-br { border-bottom-right-radius: 2px; }

.ui-corner-all, .ui-corner-bottom, .ui-corner-left, .ui-corner-bl { border-bottom-left-radius: 2px; }

.ui-corner-all, .ui-corner-top, .ui-corner-right, .ui-corner-tr { border-top-right-radius: 2px; }

.ui-dialog { padding: 0px; }

.ui-dialog .ui-dialog-titlebar { border-radius: 0px; min-height: 25px; font-size: 1rem; padding: 0.5rem 0.85rem; background: rgb(229, 229, 229); color: rgb(0, 0, 0); }

.ui-dialog .ui-icon.ui-icon-closethick { background-image: url("../img/close.png"); background-position: 50% 50%; }

.ui-dialog .ui-dialog-content { font-family: latolight; font-size: 0.975rem; color: rgb(0, 0, 0); }

.ui-dialog.ui-widget-content { border: none; box-shadow: rgb(173, 173, 173) 0px 0px 2px 2px; }

.ui-widget input, .ui-widget select, .ui-widget textarea, .ui-widget button { font-family: latolight; font-size: 0.975rem; color: rgb(0, 0, 0); }

.ui-widget { font-family: latolight; font-size: 0.875rem; }

.ui-widget-header { text-transform: uppercase; border: none; background: rgb(68, 152, 190); font-size: 0.875rem; }

.ui-tabs-nav.ui-widget-header { background: none; }

.ui-tabs .ui-tabs-nav li { border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 2px solid rgb(229, 229, 229); }

.ui-tabs .ui-tabs-nav li.ui-tabs-active { border-color: rgb(85, 170, 0); padding-bottom: 0px; }

.ui-tabs .ui-tabs-panel { padding: 2px; }

.ui-tabs .ui-state-active a { color: rgb(85, 170, 0) !important; }

.txt-message { color: rgb(61, 102, 17); }

.txt-warning { color: rgb(245, 108, 7); }

.txt-notify { color: rgb(245, 133, 80); }

.box-notify { border-radius: 4px; padding: 4px 4px 4px 24px; border: 1px solid rgb(245, 133, 80); color: rgb(245, 133, 80); margin-bottom: 3px; background: url("../img/icon_feed.png") 4px center no-repeat; }

.box-success { border-radius: 4px; padding: 4px 4px 4px 24px; border: 1px solid rgb(61, 102, 17); color: rgb(61, 102, 17); margin-bottom: 3px; background: url("../img/success_msg_icon.gif") 4px center no-repeat; }

.box-warning { border-radius: 4px; padding: 4px 4px 4px 24px; border: 1px solid rgb(245, 108, 7); color: rgb(245, 108, 7); margin-bottom: 3px; background: url("../img/warning_msg_icon.gif") 4px center no-repeat; }

.pagination { padding-bottom: 1rem; }

.pagination ul li { float: left; border: 1px solid rgb(223, 223, 223); margin: 5px; width: 40px; text-align: center; font-size: 0.85rem; }

.pagination ul li.dots { border: none; }

.pagination ul li a { color: rgb(25, 153, 217); display: block; }

.pagination ul li a:hover { background: rgb(25, 153, 217); color: rgb(255, 255, 255); }

.page-active { color: rgb(250, 60, 1); }

.fb-page { margin-top: 1rem; margin-bottom: 1rem; }

.telma { line-height: 1; position: absolute; top: 7rem; text-align: right; right: 3.5rem; }

.telma a { color: rgb(255, 255, 255); display: block; font-family: latobold; text-align: right; }

.pub { margin-top: 1rem; }

.recherche_avance_home { z-index: 5; }

.connexion { display: none; position: absolute; background: rgba(25, 153, 217, 0.9); width: 17rem; text-align: center; z-index: 20; height: auto; border-width: 0px 1px 1px; border-style: solid; border-color: rgb(204, 204, 204); border-image: initial; }

.connexion .infos { font-size: 0.85rem; color: rgb(255, 255, 255); }

.connexion .pad { padding: 1rem; }

.connexion aside { padding-bottom: 0.6rem; }

.connexion aside input { width: 98%; border: 1px solid rgb(223, 223, 223); border-radius: 2px; height: 30px; }

.connexion button { color: rgb(255, 255, 255); border: none; background: rgb(169, 180, 180); padding: 0.5rem 1rem; text-transform: uppercase; border-radius: 2px; }

.connexion .forgot { margin-top: 1rem; }

.connexion .forgot a::before { background: none !important; }

.menu_ul li.connect .menu_connect a::before { background-image: none; }

.connexion .menu_connect div { text-align: left; display: block; background: rgb(25, 153, 217); border-top: 1px dotted rgb(255, 255, 255); }

.connexion .menu_connect div a { display: block; padding-top: 5px; font-size: 0.85rem; text-transform: none; margin: 0px; }

.connexion .menu_connect div a:hover { background: rgb(137, 206, 27); color: rgb(0, 0, 0); }

.connexion .fb_ga { border-bottom: 1px solid rgb(255, 255, 255); margin-bottom: 1rem; }

.connexion .fb_ga div { margin: 0.5rem 0px; }

